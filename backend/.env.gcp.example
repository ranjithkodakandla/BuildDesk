# .env.gcp.example
# Example environment variables required for running the BuildDesk API in GCP Cloud Run.
# These should be configured in Cloud Run directly or mapped via Secret Manager.

APP_ENV=production
DEBUG=false
APP_VERSION=0.1.0

# Database Configuration
USE_SQL_REPOSITORY=true

# Database URL patterns:
# 1. Local Postgres: postgresql+psycopg://builddesk:builddesk@localhost:5432/builddesk
# 2. Cloud SQL (via Auth Proxy / Cloud Run socket): postgresql+psycopg://username:password@/database_name?host=/cloudsql/project:region:instance
DATABASE_URL=postgresql+psycopg://username:password@/database_name?host=/cloudsql/project:region:instance


# JWT (map from Secret Manager in Cloud Run — never commit real values)
JWT_SECRET_KEY=replace-via-secret-manager

# Artifact storage (GCS upload not yet implemented — keep true until Phase 16 GCS work)
USE_LOCAL_STORAGE=true
STORAGE_BUCKET=builddesk-artifacts-staging

# Allowed CORS Origins (Frontend URLs — include Vite dev + production app origin)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
