# .env.gcp.example
# Example environment variables required for running the BuildDesk API in GCP Cloud Run.
# Configure in Cloud Run or map via Secret Manager.

APP_ENV=production
DEBUG=false
APP_VERSION=0.1.0

# Database
USE_SQL_REPOSITORY=true
DATABASE_URL=postgresql+psycopg://username:password@/database_name?host=/cloudsql/project:region:instance

# JWT (Secret Manager in Cloud Run — never commit real values)
JWT_SECRET_KEY=replace-via-secret-manager

# Artifact storage (Phase 16 — GCS required for production durability)
USE_LOCAL_STORAGE=false
STORAGE_BUCKET=builddesk-artifacts-stonedesk-app
GCP_PROJECT_ID=stonedesk-app
GCS_SIGNED_URL_TTL_SECONDS=3600

# Cloud Run service account needs roles/storage.objectAdmin on STORAGE_BUCKET

# CORS — comma-separated frontend origins (Vite dev + production hosting URL)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
