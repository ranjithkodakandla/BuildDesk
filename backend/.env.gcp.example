# .env.gcp.example
# Example environment variables required for running the BuildDesk API in GCP Cloud Run.
# These should be configured in Cloud Run directly or mapped via Secret Manager.

APP_ENV=production
DEBUG=false
APP_VERSION=0.1.0

# Database Configuration (PostgreSQL)
USE_SQL_REPOSITORY=true
# Replace with the actual connection string (e.g., using Cloud SQL proxy or private IP)
DATABASE_URL=postgresql+psycopg://username:password@/database_name?host=/cloudsql/project:region:instance

# Allowed CORS Origins (Frontend URLs)
ALLOWED_ORIGINS=https://app.builddesk.example.com,https://demo.builddesk.example.com
