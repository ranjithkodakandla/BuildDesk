# BuildDesk Backend – environment variables
# Copy this file to .env and fill in values before running locally.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (tighten per tenant in production)
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (Cloud SQL / Postgres – Phase 2) ────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/buildesk

# ── GCP (Phase 2 / 3) ────────────────────────────────────────────────────────
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
